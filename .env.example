# Copy this file to `.env` and fill in what you need. `.env` is never committed.
# See docs/voice-options.md for prices, licences and which one to pick.

# Which voice to use for narration:
#   kokoro      — free, runs locally, Apache-2.0 licence (default while building)
#   elevenlabs  — paid subscription (recommended final voice: Eleven v4, Creator plan)
#   gemini      — pay-as-you-go, about $1 a month at our volume (Google AI Studio key)
#   cartesia    — paid subscription, Pro plan $5 a month
#   openai      — paid, not recommended (weak British accent)
#   google      — Google Cloud TTS Chirp 3 HD (Cloud key, not an AI Studio key)
TTS_PROVIDER=kokoro
# Free voices: British bf_emma, bf_isabella, bm_george, bm_fable…  American af_heart (used in the pilot).
KOKORO_VOICE=bf_emma

# Only needed if you switch to a paid provider. Never paste keys anywhere else.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4

GEMINI_API_KEY=
GEMINI_VOICE=Kore
# GEMINI_TTS_STYLE=Read this as a warm, curious science narrator with a natural British accent, clear and unhurried

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=
